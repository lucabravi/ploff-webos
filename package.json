{
  "name": "ploff-webos",
  "version": "1.0.8",
  "private": true,
  "description": "Development checks for Ploff for Plex on LG webOS",
  "scripts": {
    "build:styles": "node scripts/build-styles.js",
    "build:ass-legacy-worker": "node scripts/slim-ass-legacy-worker.js",
    "build:ass-wasm-worker": "node scripts/slim-ass-legacy-worker.js --wasm",
    "build:app": "node scripts/build-app.js",
    "check:styles": "node scripts/build-styles.js --check && node scripts/check-theme-contracts.js",
    "check:app-bundle": "node scripts/build-app.js --check",
    "check:ass-legacy-worker": "node scripts/slim-ass-legacy-worker.js --check && node scripts/slim-ass-legacy-worker.js --wasm --check",
    "check:release-metadata": "node scripts/check-release-metadata.js",
    "check:coordinator": "for file in app/coordinator/*.js; do node --check \"$file\" || exit 1; done",
    "check:architecture": "node scripts/check-coordinator-architecture.js",
    "check:maintainability": "node scripts/check-maintainability.js",
    "check:feature-contracts": "node scripts/check-feature-contracts.js",
    "check:performance": "node scripts/check-performance-budget.js",
    "check:es5": "node scripts/check-runtime-es5.js",
    "check:deps": "npm audit --audit-level=high",
    "check:lg-ux": "node scripts/check-lg-ux.js",
    "lint": "eslint app scripts tests webos-service eslint.config.js",
    "typecheck:contracts": "tsc --project jsconfig.contracts.json",
    "typecheck": "tsc --project jsconfig.json",
    "test:unit": "node scripts/run-unit-tests.js",
    "test:baseline": "sh tests/test-baseline.sh",
    "benchmark:home-reconcile": "node scripts/benchmark-home-reconcile.js",
    "benchmark:library-catalog": "node scripts/benchmark-library-catalog.js",
    "benchmark:ass-js-blend": "node scripts/benchmark-ass-js-blend.js",
    "test:memory": "node --expose-gc tests/pre-release-memory.js",
    "test:memory:snapshot": "PLOFF_MEMORY_SNAPSHOTS=1 node --expose-gc tests/pre-release-memory.js",
    "test:e2e": "playwright test",
    "test:e2e:debug": "PLOFF_E2E_STRICT_CHROME53=1 PWDEBUG=1 playwright test",
    "playwright:session": "node scripts/playwright-session.js",
    "test:pre-release": "npm run verify && npm run test:memory",
    "release:package": "node scripts/release-package.js",
    "check:assets": "node scripts/check-shell-assets.js app/index.html dev && node scripts/check-subtitle-renderer-assets.js",
    "test": "npm run test:unit && npm run test:baseline",
    "verify": "npm run check:styles && npm run check:app-bundle && npm run check:ass-legacy-worker && npm run check:release-metadata && npm run check:coordinator && npm run check:architecture && npm run check:maintainability && npm run check:feature-contracts && npm run check:performance && npm run check:es5 && npm run lint && npm run typecheck:contracts && npm run typecheck && npm run test && npm run check:assets && npm run check:lg-ux"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@xmldom/xmldom": "0.8.15",
    "acorn": "8.17.0",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "typescript": "7.0.2"
  }
}
