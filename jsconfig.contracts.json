  "files": [
    "types/legacy-runtime.d.ts",
    "types/runtime-contracts.d.ts",
    "app/application-session.js",
    "app/server-store.js",
    "app/media-profile.js",
    "app/watchlist-state.js",
    "app/settings.js"
  ]
}
